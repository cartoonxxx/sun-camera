<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Sun Camera</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
html,body{width:100%;height:100%;overflow:hidden;background:#141312;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;color:#f3ede8}
#cam{position:fixed;inset:0;width:100%;height:100%;object-fit:cover;transform-origin:center center;z-index:0}
#stage{position:fixed;inset:0;z-index:5;touch-action:none}
#frame{position:absolute;border:3px solid #e89b86;pointer-events:none;box-shadow:0 0 0 9999px rgba(0,0,0,0.28)}
#topbar{position:fixed;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:10px 14px;z-index:30;pointer-events:none}
#menuBtn{pointer-events:auto;background:rgba(30,28,26,.85);border-radius:24px;padding:9px 16px;font-size:15px;font-weight:600}
#modeLabel{background:rgba(30,28,26,.6);border-radius:16px;padding:6px 14px;font-size:13px;opacity:.9;pointer-events:none}
#menu{position:fixed;top:56px;left:14px;z-index:40;background:rgba(24,22,20,.97);border:1px solid #4a443f;border-radius:14px;padding:8px;display:none;min-width:260px;box-shadow:0 8px 30px rgba(0,0,0,.5)}
#menu.open{display:block}
.mitem{padding:12px 14px;border-radius:10px;font-size:15px}
.mitem:active{background:#3a352f}
.mitem.sel{color:#e89b86;font-weight:700}
.minfo{padding:10px 14px;font-size:12px;line-height:1.5;color:#b9afa6;border-top:1px solid #4a443f;margin-top:6px}
#bottom{position:fixed;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;gap:26px;padding:0 24px 26px;z-index:30;pointer-events:none}
.zbtn,#shutter{pointer-events:auto}
.zbtn{width:46px;height:46px;border-radius:50%;background:rgba(30,28,26,.85);font-size:20px;display:flex;align-items:center;justify-content:center}
#shutter{width:76px;height:76px;border-radius:50%;background:#e89b86;border:4px solid #fff;box-shadow:0 4px 18px rgba(0,0,0,.4)}
#shutter:active{transform:scale(.94)}
#toast{position:fixed;left:50%;bottom:120px;transform:translateX(-50%);background:rgba(20,18,16,.92);color:#f3ede8;padding:10px 16px;border-radius:12px;font-size:13px;z-index:90;display:none;max-width:92vw;text-align:center;line-height:1.45}
#veil{position:fixed;inset:0;z-index:80;display:none;background:#141312;color:#b9afa6;align-items:center;justify-content:center;font-size:14px;text-align:center;padding:30px}
#gal{position:fixed;inset:0;z-index:70;background:#141312;display:none;flex-direction:column}
#galHead{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid #4a443f;gap:8px}
#galClose,#galRefresh{background:rgba(30,28,26,.85);border-radius:20px;padding:8px 14px;font-size:14px;white-space:nowrap}
#galPath{font-size:12px;color:#b9afa6;flex:1;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#galScroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:10px}
#galGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.gitem{position:relative;border-radius:10px;overflow:hidden;background:#221f1c;aspect-ratio:1/1}
.gitem img{width:100%;height:100%;object-fit:cover;display:block}
.gcap{position:absolute;left:0;right:0;bottom:0;background:rgba(0,0,0,.55);font-size:10px;padding:3px 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gempty{grid-column:1/-1;color:#b9afa6;font-size:14px;padding:30px 10px;text-align:center}
#galDetail{display:none;position:absolute;inset:0;background:#141312;flex-direction:column;z-index:2}
#galImgWrap{flex:1;overflow:hidden;display:flex;align-items:center;justify-content:center}
#galImg{max-width:100%;max-height:100%}
#galBar{display:flex;justify-content:space-around;padding:14px 10px 26px;border-top:1px solid #4a443f;gap:8px}
.gbtn{background:rgba(30,28,26,.85);border-radius:24px;padding:12px 16px;font-size:15px;white-space:nowrap}
.gbtn.warn{color:#e07a63}
</style>
</head>
<body>
<video id="cam" playsinline muted autoplay></video>
<div id="stage"><div id="frame"></div></div>
<div id="topbar">
  <div id="menuBtn">☰ Меню</div>
  <div id="modeLabel">Сторис</div>
</div>
<div id="menu">
  <div class="mitem sel" data-mode="story">Сторис</div>
  <div class="mitem" data-mode="cover">Обложка сторис</div>
  <div class="mitem" data-mode="work">Работы</div>
  <div class="mitem" id="miTurn">Поворот работ: горизонталь</div>
  <div class="mitem" id="miCam">Камера: основная</div>
  <div class="mitem" id="miGal">🖼 Галерея</div>
  <div class="mitem" id="miFolder">📁 Папка: Sun Nails</div>
  <div class="mitem" id="miReset">Рамка: на весь экран</div>
  <div class="minfo">Рамка: один палец — перетащить, два пальца — растянуть или сузить, от маленькой до почти полного экрана.<br>Файлы сохраняются в «Документы / Sun Nails». Ярлык папки на рабочий стол: «Мои файлы» → Документы → Sun Nails → удержать → «Добавить на главный экран».</div>
</div>
<div id="bottom">
  <div class="zbtn" id="zoomOut">−</div>
  <div id="shutter"></div>
  <div class="zbtn" id="zoomIn">+</div>
</div>
<div id="toast"></div>
<div id="veil">Возвращаю камеру…</div>
<div id="gal">
  <div id="galHead">
    <div id="galClose">← Закрыть</div>
    <div id="galPath">Документы / Sun Nails</div>
    <div id="galRefresh">↻</div>
  </div>
  <div id="galScroll"><div id="galGrid"></div></div>
  <div id="galDetail">
    <div id="galImgWrap"><img id="galImg" alt=""></div>
    <div id="galBar">
      <div class="gbtn" id="galBack">← Назад</div>
      <div class="gbtn" id="galShare">↗ Поделиться</div>
      <div class="gbtn warn" id="galDel">🗑 Удалить</div>
    </div>
  </div>
</div>
<script>
(function(){
"use strict";
var video=document.getElementById('cam');
var stage=document.getElementById('stage');
var frame=document.getElementById('frame');
var menu=document.getElementById('menu');
var menuBtn=document.getElementById('menuBtn');
var modeLabel=document.getElementById('modeLabel');
var toastEl=document.getElementById('toast');
var veil=document.getElementById('veil');
var miTurn=document.getElementById('miTurn');
var miCam=document.getElementById('miCam');
var miGal=document.getElementById('miGal');
var miFolder=document.getElementById('miFolder');
var miReset=document.getElementById('miReset');
var zoomIn=document.getElementById('zoomIn');
var zoomOut=document.getElementById('zoomOut');
var shutter=document.getElementById('shutter');
var gal=document.getElementById('gal');
var galClose=document.getElementById('galClose');
var galRefresh=document.getElementById('galRefresh');
var galPath=document.getElementById('galPath');
var galGrid=document.getElementById('galGrid');
var galDetail=document.getElementById('galDetail');
var galImg=document.getElementById('galImg');
var galBack=document.getElementById('galBack');
var galShare=document.getElementById('galShare');
var galDel=document.getElementById('galDel');
var FS=null;
try{ FS=(window.Capacitor&&Capacitor.Plugins)?Capacitor.Plugins.Filesystem:null; }catch(e){ FS=null; }

var MODES={story:'Сторис',cover:'Обложка',work:'Работы'};
var ASPECT={story:9/16,cover:1080/800,work:4/3};
var NAMES={story:'kadr_storis',cover:'oblojka_storis',work:'rabota'};
var TOP_SAFE=70,BOTTOM_SAFE=160;
var MIN_SCALE=0.15,MAX_SCALE=1;

var S={mode:'story',zoom:1,cssZoom:1,scale:1,workHoriz:true,facing:'environment',mirrored:false,stream:null,ready:false,off:{x:0,y:0}};
var galCur=null;

function toast(t,ms){
  toastEl.textContent=t;toastEl.style.display='block';
  clearTimeout(toastEl._h);toastEl._h=setTimeout(function(){toastEl.style.display='none';},ms||3000);
}
function clamp(v,a,b){return Math.max(a,Math.min(b,v));}
function aspect(){ if(S.mode==='work')return S.workHoriz?4/3:3/4; return ASPECT[S.mode]; }

function clampOff(){
  var W=innerWidth,H=innerHeight,maxH=H-TOP_SAFE-BOTTOM_SAFE;
  var fw=frame.offsetWidth,fh=frame.offsetHeight;
  var maxX=Math.max(0,(W-fw)/2-4), maxY=Math.max(0,(maxH-fh)/2-2);
  if(S.off.x>maxX)S.off.x=maxX; if(S.off.x<-maxX)S.off.x=-maxX;
  if(S.off.y>maxY)S.off.y=maxY; if(S.off.y<-maxY)S.off.y=-maxY;
}
function place(){
  var W=innerWidth,H=innerHeight,maxH=H-TOP_SAFE-BOTTOM_SAFE;
  var cx=W/2+S.off.x, cy=TOP_SAFE+maxH/2+S.off.y;
  frame.style.left=(cx-frame.offsetWidth/2)+'px';
  frame.style.top=(cy-frame.offsetHeight/2)+'px';
}
function layout(){
  var W=innerWidth,H=innerHeight,maxH=H-TOP_SAFE-BOTTOM_SAFE,maxW=W*0.97;
  var asp=aspect();
  var fitW=Math.min(maxW,maxH*asp);
  S.scale=clamp(S.scale,MIN_SCALE,MAX_SCALE);
  var w=fitW*S.scale,h=w/asp;
  if(h>maxH){h=maxH;w=h*asp;}
  frame.style.width=w+'px';frame.style.height=h+'px';
  clampOff();place();
}

/* --- жесты: touch-события, один палец тянет, два — меняют размер --- */
var T={},order=[],ges=null;
function dist(a,b){return Math.hypot(a.x-b.x,a.y-b.y);}
function syncGesture(){
  if(order.length>=2){
    var a=T[order[0]],b=T[order[1]];
    var d=(a&&b)?dist(a,b):0;
    ges={t:'pinch',d0:(d>10?d:1),s0:S.scale};
  } else if(order.length===1){
    var t=T[order[0]];
    ges={t:'drag',x:t.x,y:t.y,ox:S.off.x,oy:S.off.y};
  } else ges=null;
}
stage.addEventListener('touchstart',function(e){
  e.preventDefault();
  for(var i=0;i<e.changedTouches.length;i++){
    var t=e.changedTouches[i];
    if(T[t.identifier]===undefined){T[t.identifier]={x:t.clientX,y:t.clientY};order.push(t.identifier);}
    else {T[t.identifier].x=t.clientX;T[t.identifier].y=t.clientY;}
  }
  syncGesture();
},{passive:false});
stage.addEventListener('touchmove',function(e){
  e.preventDefault();
  for(var i=0;i<e.changedTouches.length;i++){
    var t=e.changedTouches[i];
    if(T[t.identifier]!==undefined){T[t.identifier].x=t.clientX;T[t.identifier].y=t.clientY;}
  }
  if(ges&&ges.t==='pinch'&&order.length>=2){
    var a=T[order[0]],b=T[order[1]];
    if(!a||!b)return;
    var d=dist(a,b);
    if(ges.d0>10){
      S.scale=clamp(ges.s0*d/ges.d0,MIN_SCALE,MAX_SCALE);
      layout();
    }
  } else if(ges&&ges.t==='drag'&&order.length===1){
    var t=T[order[0]];
    S.off.x=ges.ox+(t.x-ges.x);
    S.off.y=ges.oy+(t.y-ges.y);
    clampOff();place();
  }
},{passive:false});
function endTouch(e){
  for(var i=0;i<e.changedTouches.length;i++)delete T[e.changedTouches[i].identifier];
  order=order.filter(function(id){return T[id]!==undefined;});
  syncGesture();
}
stage.addEventListener('touchend',endTouch);
stage.addEventListener('touchcancel',endTouch);

/* --- камера --- */
function applyVideoTransform(){
  video.style.transform='scale('+(S.mirrored?-S.cssZoom:S.cssZoom)+','+S.cssZoom+')';
}
function startCam(){
  var p=navigator.mediaDevices.getUserMedia({video:{facingMode:S.facing,width:{ideal:1920},height:{ideal:1080}},audio:false});
  p.then(function(st){
    if(S.stream)S.stream.getTracks().forEach(function(t){t.stop();});
    S.stream=st;video.srcObject=st;
    S.mirrored=(S.facing==='user');
    return video.play();
  }).then(function(){
    S.ready=true;applyVideoTransform();
  }).catch(function(err){
    S.ready=false;
    toast('Нет доступа к камере: '+(err&&err.name?err.name:'ошибка'),4000);
  });
}
function restartCam(){
  veil.style.display='flex';
  setTimeout(function(){
    startCam();
    setTimeout(function(){veil.style.display='none';},400);
  },60);
}
document.addEventListener('visibilitychange',function(){
  if(document.hidden){S._wasHidden=true;}
  else if(S._wasHidden){S._wasHidden=false;restartCam();}
});

/* --- зум камеры --- */
function setZoom(z){
  S.zoom=clamp(z,1,6);
  var tr=S.stream?S.stream.getVideoTracks()[0]:null;
  var optical=false;
  if(tr&&tr.getCapabilities&&tr.getCapabilities().zoom){
    var cap=tr.getCapabilities().zoom;
    var v=cap.min+(cap.max-cap.min)*(S.zoom-1)/5;
    try{tr.applyConstraints({advanced:[{zoom:v}]});optical=true;}catch(e){}
  }
  S.cssZoom=optical?1:S.zoom;
  applyVideoTransform();
}
zoomIn.addEventListener('click',function(){setZoom(S.zoom*1.25);});
zoomOut.addEventListener('click',function(){setZoom(S.zoom/1.25);});

/* --- нумерация и сохранение --- */
function nextNumber(prefix){
  if(!FS)return Promise.resolve(1);
  return FS.readdir({path:'Sun Nails',directory:'DOCUMENTS'}).then(function(res){
    var m=0;
    res.files.forEach(function(f){
      var mt=f.name.match(new RegExp('^'+prefix+'(?:__(\\d+))?\\.jpg$','i'));
      if(mt)m=Math.max(m,mt[1]?parseInt(mt[1],10):1);
    });
    return m+1;
  }).catch(function(){return 1;});
}
function saveFile(name,data){
  return FS.writeFile({path:'Sun Nails/'+name,directory:'DOCUMENTS',data:data,recursive:true});
}
function capture(){
  if(!S.ready){toast('Камера ещё не готова');return;}
  var vw=video.videoWidth,vh=video.videoHeight;
  if(!vw){toast('Камера ещё не готова');return;}
  var W=innerWidth,H=innerHeight;
  var fr=frame.getBoundingClientRect();
  var z=S.cssZoom;
  var s0=Math.max(W/vw,H/vh);
  var ox=(W-vw*s0)/2,oy=(H-vh*s0)/2;
  function conv(px,py){
    var x=(px-W/2)/z+W/2, y=(py-H/2)/z+H/2;
    x=(x-ox)/s0; y=(y-oy)/s0;
    if(S.mirrored)x=vw-x;
    return [x,y];
  }
  var c0=conv(fr.left,fr.top),c1=conv(fr.right,fr.bottom);
  var x0=Math.min(c0[0],c1[0]),x1=Math.max(c0[0],c1[0]);
  var y0=Math.min(c0[1],c1[1]),y1=Math.max(c0[1],c1[1]);
  x0=Math.max(0,Math.min(vw,x0));x1=Math.max(0,Math.min(vw,x1));
  y0=Math.max(0,Math.min(vh,y0));y1=Math.max(0,Math.min(vh,y1));
  var cw=x1-x0,ch=y1-y0;
  if(cw<10||ch<10){toast('Кадр за пределами камеры — уменьшите зум');return;}
  var outW,outH;
  if(S.mode==='work'){outW=S.workHoriz?1600:1200;outH=S.workHoriz?1200:1600;}
  else if(S.mode==='story'){outW=1080;outH=1920;}
  else {outW=1080;outH=800;}
  var full=document.createElement('canvas');full.width=vw;full.height=vh;
  var fx=full.getContext('2d');
  if(S.mirrored){fx.translate(vw,0);fx.scale(-1,1);}
  fx.drawImage(video,0,0,vw,vh);
  var crop=document.createElement('canvas');crop.width=outW;crop.height=outH;
  crop.getContext('2d').drawImage(full,x0,y0,cw,ch,0,0,outW,outH);
  var oc=document.createElement('canvas');
  var k=Math.min(1,1920/Math.max(vw,vh));
  oc.width=Math.round(vw*k);oc.height=Math.round(vh*k);
  oc.getContext('2d').drawImage(full,0,0,oc.width,oc.height);
  var data=crop.toDataURL('image/jpeg',0.92).split(',')[1];
  var odata=oc.toDataURL('image/jpeg',0.9).split(',')[1];
  if(!FS){toast('Файловая система недоступна');return;}
  var prefix=NAMES[S.mode];
  nextNumber(prefix).then(function(n){
    var main=prefix+(n>1?'__'+n:'')+'.jpg';
    var orig='original'+(n>1?'__'+n:'')+'.jpg';
    return saveFile(main,data).then(function(){
      return saveFile(orig,odata);
    }).then(function(){
      toast('Сохранено в Sun Nails: '+main);
    });
  }).catch(function(e){
    toast('Не удалось сохранить: '+((e&&e.message)||e),4000);
  });
}
shutter.addEventListener('click',capture);

/* --- меню --- */
menuBtn.addEventListener('click',function(e){e.stopPropagation();menu.classList.toggle('open');});
document.addEventListener('click',function(e){
  if(!menu.contains(e.target)&&e.target!==menuBtn)menu.classList.remove('open');
});
var items=document.querySelectorAll('.mitem[data-mode]');
for(var i=0;i<items.length;i++){
  (function(el){
    el.addEventListener('click',function(){
      S.mode=el.getAttribute('data-mode');
      for(var j=0;j<items.length;j++)items[j].classList.toggle('sel',items[j]===el);
      modeLabel.textContent=MODES[S.mode];
      menu.classList.remove('open');
      S.off={x:0,y:0};S.scale=1;
      layout();
    });
  })(items[i]);
}
miTurn.addEventListener('click',function(){
  S.workHoriz=!S.workHoriz;
  miTurn.textContent='Поворот работ: '+(S.workHoriz?'горизонталь':'вертикаль');
  menu.classList.remove('open');layout();
});
miCam.addEventListener('click',function(){
  S.facing=(S.facing==='environment')?'user':'environment';
  miCam.textContent='Камера: '+(S.facing==='user'?'фронтальная':'основная');
  menu.classList.remove('open');
  restartCam();
});
miGal.addEventListener('click',function(){menu.classList.remove('open');openGal();});
miFolder.addEventListener('click',function(){
  menu.classList.remove('open');
  toast('Сохранение: Документы / Sun Nails. Ярлык папки: «Мои файлы» → Документы → Sun Nails → удержать → «Добавить на главный экран»',5000);
});
miReset.addEventListener('click',function(){
  S.scale=1;S.off={x:0,y:0};
  menu.classList.remove('open');layout();
});
window.addEventListener('resize',layout);
document.addEventListener('contextmenu',function(e){e.preventDefault();});

/* --- галерея --- */
function openGal(){
  gal.style.display='flex';
  galDetail.style.display='none';
  refreshGal();
}
function refreshGal(){
  galGrid.innerHTML='';
  if(!FS){galGrid.innerHTML='<div class="gempty">Файловая система недоступна</div>';return;}
  FS.readdir({path:'Sun Nails',directory:'DOCUMENTS'}).then(function(res){
    var files=res.files.filter(function(f){return /\.jpg$/i.test(f.name);});
    files.sort(function(a,b){return a.name<b.name?-1:(a.name>b.name?1:0);});
    files.reverse();
    if(!files.length){galGrid.innerHTML='<div class="gempty">Пока нет снимков. Сделайте первый!</div>';return;}
    files.forEach(function(f){addThumb(f.name);});
  }).catch(function(){
    galGrid.innerHTML='<div class="gempty">Папка Sun Nails пока пуста</div>';
  });
}
function addThumb(name){
  FS.readFile({path:'Sun Nails/'+name,directory:'DOCUMENTS'}).then(function(r){
    var data=String(r.data).replace(/^data:image\/\w+;base64,/,'');
    var url='data:image/jpeg;base64,'+data;
    var d=document.createElement('div');d.className='gitem';
    var img=document.createElement('img');img.src=url;
    var cap=document.createElement('div');cap.className='gcap';cap.textContent=name;
    d.appendChild(img);d.appendChild(cap);
    d.addEventListener('click',function(){showDetail(name,url);});
    galGrid.appendChild(d);
  }).catch(function(){});
}
function showDetail(name,url){
  galCur={name:name,url:url};
  galImg.src=url;
  galDetail.style.display='flex';
}
galClose.addEventListener('click',function(){gal.style.display='none';galCur=null;});
galRefresh.addEventListener('click',refreshGal);
galBack.addEventListener('click',function(){galDetail.style.display='none';galCur=null;});
var delArm=false,delTimer=0;
galDel.addEventListener('click',function(){
  if(!galCur)return;
  if(!delArm){
    delArm=true;galDel.textContent='Точно удалить?';
    delTimer=setTimeout(function(){delArm=false;galDel.textContent='🗑 Удалить';},2500);
    return;
  }
  clearTimeout(delTimer);delArm=false;galDel.textContent='🗑 Удалить';
  FS.deleteFile({path:'Sun Nails/'+galCur.name,directory:'DOCUMENTS'}).then(function(){
    toast('Удалено: '+galCur.name);
    galDetail.style.display='none';
    refreshGal();
  }).catch(function(e){toast('Не удалось удалить: '+((e&&e.message)||e),3500);});
  galCur=null;
});
galShare.addEventListener('click',function(){
  if(!galCur||!FS)return;
  var name=galCur.name;
  FS.readFile({path:'Sun Nails/'+name,directory:'DOCUMENTS'}).then(function(r){
    var b64=String(r.data).replace(/^data:image\/\w+;base64,/,'');
    var bin=atob(b64),arr=new Uint8Array(bin.length);
    for(var i=0;i<bin.length;i++)arr[i]=bin.charCodeAt(i);
    var file=new File([arr],name,{type:'image/jpeg'});
    if(navigator.canShare&&navigator.canShare({files:[file]})){
      return navigator.share({files:[file],title:name});
    }
    if(navigator.share){return navigator.share({title:name});}
    toast('Меню отправки недоступно — отправьте из галереи телефона',3500);
  }).catch(function(e){
    if(e&&e.name==='AbortError')return;
    toast('Не удалось поделиться: '+((e&&e.message)||e),3500);
  });
});

layout();
startCam();
})();
</script>
</body>
</html>
